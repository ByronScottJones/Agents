#!/usr/bin/env bash
set -euo pipefail

# Only run Rust checks if Rust or Cargo files are staged
STAGED_RUST_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(\.rs$|Cargo\.(toml|lock)$|deny\.toml$|rustfmt\.toml$)' || true)

if [[ -z "$STAGED_RUST_FILES" ]]; then
    exit 0
fi

export CARGO_TERM_COLOR=always
export RUSTFLAGS="-Dwarnings"
export RUSTDOCFLAGS="-Dwarnings"

echo "==> [1/5] Checking formatting (cargo fmt)..."
cargo fmt --all -- --check

echo "==> [2/5] Linting with Clippy (cargo clippy)..."
cargo clippy --workspace --all-targets --all-features -- -D warnings

# cargo-deny is mandatory: rust.md requires 'cargo deny check' to pass
if ! command -v cargo-deny >/dev/null 2>&1; then
    echo "error: cargo-deny is not installed; run 'cargo install cargo-deny --locked'" >&2
    exit 1
fi
echo "==> [3/5] Auditing dependencies (cargo deny)..."
cargo deny check

echo "==> [4/5] Running tests (cargo test)..."
cargo test --workspace --all-targets --all-features

# Doc tests need a library target; binary-only projects fail with "no library targets found"
if [[ -n "$(find . -path ./target -prune -o -path '*/src/lib.rs' -print -quit)" ]]; then
    echo "==> [5/5] Running doc tests (cargo test --doc)..."
    cargo test --workspace --doc --all-features
else
    echo "==> [5/5] Skipping doc tests (no library target found)"
fi

echo "==> All pre-commit checks passed!"
