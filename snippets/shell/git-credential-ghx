#!/usr/bin/env bash
# git-credential-ghx: git credential helper that supplies the GitHub token of
# the account that owns the repository being accessed.
#
# git runs it as "git-credential-ghx get" and sends key=value lines on stdin.
# The helper answers only for https://github.com and needs the repository path
# to find the owner, so enable it with:
#
#   git config --global credential.https://github.com.useHttpPath true
#   git config --global --replace-all credential.https://github.com.helper ''
#   git config --global --add credential.https://github.com.helper ghx
#
# (the empty value resets any helper configured earlier, such as
# "gh auth git-credential", whose token can be stale; "ghx" resolves to this
# script as git-credential-ghx on PATH.)
#
# Token lookup matches ghx: group "github.com" (GHX_SECRETS_GROUP), key
# "<owner>_GHTOKEN" with the owner in lowercase, in ~/.secrets/secrets.json
# (GHX_SECRETS_FILE). The token is printed only to git, in the credential
# protocol, and never logged. For any other host, action, or missing token the
# helper prints nothing so git can try its next helper.

set -euo pipefail

SECRETS_FILE="${GHX_SECRETS_FILE:-${HOME}/.secrets/secrets.json}"
SECRETS_GROUP="${GHX_SECRETS_GROUP:-github.com}"

# Prints a diagnostic to stderr without exiting.
warn() {
  printf 'git-credential-ghx: %s\n' "$*" >&2
}

main() {
  local line key value protocol="" host="" path="" owner token

  # Only the "get" action is answered; "store" and "erase" are ignored because
  # the token lives in the secrets file, not in git's cache.
  [[ "${1:-}" == "get" ]] || exit 0

  # Read the credential request: key=value lines ending at a blank line.
  while IFS= read -r line; do
    [[ -n "${line}" ]] || break
    key="${line%%=*}"
    value="${line#*=}"
    case "${key}" in
      protocol) protocol="${value}" ;;
      host) host="${value}" ;;
      path) path="${value}" ;;
    esac
  done

  [[ "${protocol}" == "https" && "${host}" == "github.com" ]] || exit 0
  if [[ -z "${path}" ]]; then
    warn "no repository path in request; set credential.https://github.com.useHttpPath true"
    exit 0
  fi

  owner="${path%%/*}"
  if [[ ! "${owner}" =~ ^[A-Za-z0-9-]+$ ]]; then
    warn "unexpected owner in request path"
    exit 0
  fi
  owner="$(printf '%s' "${owner}" | tr '[:upper:]' '[:lower:]')"

  if [[ ! -f "${SECRETS_FILE}" ]] || ! command -v jq >/dev/null 2>&1; then
    warn "secrets file or jq not available"
    exit 0
  fi

  token="$(jq -r --arg group "${SECRETS_GROUP}" --arg key "${owner}_GHTOKEN" \
    '.[$group][$key] // empty' "${SECRETS_FILE}" 2>/dev/null || true)"
  if [[ -z "${token}" ]]; then
    warn "no token for '${owner}': add key '${owner}_GHTOKEN' to group '${SECRETS_GROUP}'"
    exit 0
  fi

  printf 'username=x-access-token\npassword=%s\n' "${token}"
}

main "$@"
